#!/bin/bash
# Bidirectional folder sync, driven by ~/.config/filesync/filesync.conf.
#
# Engine is unison, not rsync: rsync is one-directional. Run it both ways and it
# cannot tell "deleted here" from "created there", so deletions resurrect and
# nothing detects a genuine conflict. unison keeps a per-pair archive of the
# last agreed state, which is what makes two-way sync safe.
#
# Deux réglages indépendants par paire :
#
#   direction = twoway | push (local -> NAS) | pull (NAS -> local)
#   deletions = keep   (défaut) la destination ne perd jamais rien
#               mirror          la destination devient identique à la source
#
# Le second existe parce qu'un sens unique n'est PAS additif par nature : voir
# le commentaire au-dessus du case sur « force ».
#
#   filesync sync [--force] [Pair_Name]   run it
#   filesync dry  [Pair_Name]             show what would happen, change nothing
#   filesync status                       current configuration and last result
set -u
CONF="$HOME/.config/filesync/filesync.conf"
LOGDIR="$HOME/.cache/filesync"; mkdir -p "$LOGDIR"
# unison range ses profils ET ses archives ici. Il crée le répertoire lui-même
# au premier lancement, mais write_profile y écrit AVANT qu'unison ne tourne :
# sans ce mkdir, la toute première paire jamais synchronisée échouait sur
# « Profile does not exist », unison créait le répertoire en sortant en erreur,
# et les paires suivantes marchaient. Le défaut ne se voyait donc qu'une fois.
UNISONDIR="$HOME/.unison"; mkdir -p "$UNISONDIR"
# unison indexe ses archives par nom d'hôte. Renommer la machine — ou recevoir
# un nom différent par DHCP — rend toutes les archives illisibles : unison
# reconsidère alors chaque fichier comme nouveau, propose de tout recopier et
# ne détecte plus aucun conflit. C'est précisément ce que son propre
# avertissement « UNISONLOCALHOSTNAME » décrit. On épingle donc une valeur
# stable, indépendante du nom courant de la machine.
export UNISONLOCALHOSTNAME="${UNISONLOCALHOSTNAME:-latitude1}"
LOG="$LOGDIR/filesync.log"
say() { printf '[%s] %s\n' "$(date -Is)" "$*" >>"$LOG"; }

# QSettings writes [General] keys, and awk reads them the same way.
ini() {
    awk -v s="[$1]" -v k="$2" '
        /^\[/ { inx = ($0 == s) }
        inx && index($0, k"=") == 1 { sub("^"k"=",""); gsub(/^"|"$/,""); print; exit }
    ' "$CONF"
}
pairs() { grep -o '^\[Pair_[A-Za-z0-9_]*\]' "$CONF" | tr -d '[]'; }

nas_ready() {
    # The share is behind an automount that releases it after 10 idle minutes,
    # so "not mounted right now" does NOT mean unavailable. Touch the path to
    # let the automount do its job, THEN check. Without this every sync was
    # skipped once the share had been idle.
    ls /mnt/nas >/dev/null 2>&1
    findmnt -no FSTYPE /mnt/nas 2>/dev/null | grep -q cifs
}

write_profile() {   # $1 = section, $2 = sync|dry -> echoes profile name
    local sec="$1" mode="${2:-sync}" name="${1#Pair_}" l r pol dir del prf
    l=$(ini "$sec" local); r=$(ini "$sec" remote)
    pol=$(ini General conflictPolicy); pol=${pol:-newer}
    dir=$(ini "$sec" direction); dir=${dir:-twoway}
    # Le défaut est le mode qui ne perd rien. Une configuration écrite avant
    # l'existence de cette clé se lit donc comme « ne supprime pas », ce qui
    # change le comportement de push/pull dans le sens le moins destructeur.
    del=$(ini "$sec" deletions); del=${del:-keep}
    [ "$mode" = dry ] && name="${name}-preview"
    prf="$UNISONDIR/${name,,}.prf"
    {
        echo "root = $l"
        echo "root = $r"
        # A preview profile must NOT say batch=true. With it, unison acts the
        # moment it is run instead of asking - which is how a "dry run" once
        # copied 282 files for real.
        [ "$mode" = dry ] && echo "batch = false" || echo "batch = true"
        echo "times = true"
        # CIFS maps ownership with uid=/gid= and cannot round-trip Unix modes,
        # so comparing permissions would flag every file as different.
        echo "perms = 0"
        echo "dontchmod = true"
        # Le coût dominant est la LATENCE par fichier, pas le calcul : mesuré sur
        # ce montage, 200 stat() prennent 6 ms en local contre 7163 ms en CIFS,
        # soit ~36 ms par fichier. Un travail dominé par l'attente réseau se
        # parallélise bien ; 4 fils laissaient le lien inoccupé l'essentiel du
        # temps. Au-delà d'une vingtaine, les NAS grand public commencent à
        # refuser des requêtes, d'où cette valeur plutôt que davantage.
        echo "maxthreads = 20"
        # Comparer par (taille, date) plutôt que relire le contenu. C'est le
        # défaut d'unison sous Unix, mais l'écrire noir sur blanc évite qu'une
        # version future le change sous nos pieds : relire 30 000 fichiers à
        # travers CIFS se compterait en heures.
        echo "fastcheck = true"
        echo "log = true"
        echo "logfile = $LOGDIR/${name,,}.log"
        # « force = racine » résout TOUTE différence en faveur de cette racine,
        # et « ce fichier n'existe que de l'autre côté » en est une : unison le
        # supprime. Un push n'est donc pas additif, c'est un miroir. Envoyer un
        # dossier local vide vers un NAS plein le vidait intégralement.
        #
        # « nodeletion = racine » interdit toute suppression DANS cette racine.
        # Combiné à force, on obtient le mode réellement additif : la source
        # impose son contenu, la destination ne perd jamais ce qu'elle a en
        # propre. C'est le défaut.
        case "$dir" in
            push) echo "force = $l"
                  [ "$del" = mirror ] || echo "nodeletion = $r" ;;
            pull) echo "force = $r"
                  [ "$del" = mirror ] || echo "nodeletion = $l" ;;
            *)    [ "$pol" = "newer" ] && echo "prefer = newer"
                  # En bidirectionnel, « keep » protège les deux côtés : une
                  # suppression ici cesse de se propager là-bas.
                  if [ "$del" != mirror ]; then
                      echo "nodeletion = $l"
                      echo "nodeletion = $r"
                  fi
                  # « le plus récent gagne » écrase l'autre version sans laisser
                  # de trace. Garder la copie perdante coûte un fichier et rend
                  # l'arbitrage réversible.
                  echo "copyonconflict = true" ;;
        esac
        # Filet d'unison : refuser de propager la disparition d'une réplique
        # entière (montage tombé, dossier renommé). En batch il interrompt au
        # lieu de demander, ce qui est exactement le comportement voulu. Le
        # mode dry le désactive déjà sur sa ligne de commande.
        [ "$mode" = dry ] || echo "confirmbigdel = true"
        echo "ignore = Name .Trash-*"
        echo "ignore = Name .stfolder"
        echo "ignore = Name .DS_Store"
        echo "ignore = Name *.part"
        echo "ignore = Name .fuse_hidden*"
        # user patterns, one per line in the config (\n-escaped by QSettings)
        ini General ignorePatterns | tr '\n' '\034' | sed 's/\\\\n/\034/g' | tr '\034' '\n' |
        while IFS= read -r pat; do
            [ -n "${pat// /}" ] && echo "ignore = Name $pat"
        done
    } > "$prf"
    # Renvoyer le nom d'un profil qui n'existe pas envoie unison droit dans
    # « Profile does not exist », une erreur qui ne dit rien de la vraie cause.
    if [ ! -s "$prf" ]; then
        say "$name: impossible d'écrire le profil $prf"
        return 1
    fi
    # unison wants the profile NAME: it looks in ~/.unison and appends .prf
    printf '%s' "${name,,}"
}

empty_dir() {   # « vide » / « plein » ; s'arrête au premier fichier trouvé
    find "$1" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null | grep -q . \
        && echo plein || echo vide
}

guard_roots() {  # $1 = section ; refuse les configurations qui détruiraient des données
    local sec="$1" name="${1#Pair_}" l r dir del src dst
    l=$(ini "$sec" local); r=$(ini "$sec" remote)
    dir=$(ini "$sec" direction); dir=${dir:-twoway}
    del=$(ini "$sec" deletions); del=${del:-keep}

    # Une racine absente n'est pas une racine vide. unison, lui, ne fait pas la
    # différence : il la recrée et propage « tout a disparu » vers l'autre côté.
    # Un montage tombé ou un dossier renommé suffisait donc à vider la copie.
    [ -d "$l" ] || { say "$name: dossier local absent ($l) - paire ignorée"; return 1; }
    [ -d "$r" ] || { say "$name: dossier distant absent ($r) - paire ignorée"; return 1; }

    # Le reste ne concerne que le miroir : « keep » ne supprime rien par
    # construction, il n'y a rien à protéger.
    [ "$del" = mirror ] || return 0
    case "$dir" in
        push) src="$l"; dst="$r" ;;
        pull) src="$r"; dst="$l" ;;
        *)    return 0 ;;
    esac
    if [ "$(empty_dir "$src")" = vide ] && [ "$(empty_dir "$dst")" = plein ]; then
        say "$name: REFUS - miroir d'une source vide ($src) vers une destination pleine ($dst)"
        return 1
    fi
    return 0
}

run_pair() {  # run_pair <section> <sync|dry>
    local sec="$1" mode="$2" prf name
    name="${sec#Pair_}"
    if [ "$mode" = sync ] && [ "$(ini "$sec" enabled)" != "true" ]; then
        say "$name: disabled, skipped"; return 0
    fi
    guard_roots "$sec" || return 1
    if ! prf=$(write_profile "$sec" "$mode"); then
        say "$name: profil non généré, paire ignorée"; return 1
    fi
    if [ "$mode" = dry ]; then
        local d; d=$(ini "$sec" deletions); d=${d:-keep}
        echo "=== $name   $(ini "$sec" local)  <->  $(ini "$sec" remote)   [$(ini "$sec" direction), suppressions: $d]"
        # -batch=false on the command line as well as in the profile, and "q"
        # on stdin so the reconciliation list is printed and then abandoned.
        # The preview quits before writing an archive, so unison shows its
        # first-run banner every time. Strip it; the reconciliation list is
        # the part worth reading.
        printf '\nq\n' | timeout 600 unison "$prf" -batch=false -auto=false -ui text -dumbtty -terse -confirmbigdel=false 2>&1 \
          | grep -vE 'archive files were found|^This can happen|^because this is|^or because you|^archive format|^Update detection|^large\.|^Unison will assume|^was completely empty|^will be reported|^replica will be|^If the two replicas|^If you see this|^is getting its|^between synchron|^environment variable|^Press return|^\s*$' \
          | head -80
        echo
    else
        say "$name: syncing ($(ini "$sec" direction))"
        unison "$prf" -ui text -dumbtty </dev/null >>"$LOG" 2>&1
        local rc=$?; say "$name: unison exit $rc"; return $rc
    fi
}

# Only one sync at a time. The initial pull runs for hours and writes into the
# very directories the 5s watcher is watching, so without this the watcher and
# the 15-minute timer would both start further unison runs on top of it.
LOCK="$LOGDIR/.lock"
exec 9>"$LOCK"

CMD="${1:-sync}"; shift || true
FORCE=0
[ "${1:-}" = "--force" ] && { FORCE=1; shift; }
ONLY="${1:-}"

case "$CMD" in
  sync)
      if [ "$FORCE" != 1 ] && [ "$(ini General enabled)" != "true" ]; then
          say "master switch off, nothing done"; exit 0
      fi
      nas_ready || { say "NAS not mounted, skipping this run"; exit 0; }
      if ! flock -n 9; then
          say "another sync is already running, skipping"
          exit 0
      fi
      rc=0
      for p in $(pairs); do
          [ -n "$ONLY" ] && [ "$p" != "$ONLY" ] && continue
          run_pair "$p" sync || rc=1
      done
      if [ "$(ini General notify)" != "false" ] && command -v notify-send >/dev/null; then
          [ "$rc" = 0 ] && notify-send -i folder-sync "File sync" "Finished." \
                        || notify-send -u critical -i folder-sync "File sync" "Errors - see the log."
      fi
      exit $rc
      ;;
  dry)
      nas_ready || { echo "The NAS is not mounted."; exit 1; }
      for p in $(pairs); do
          [ -n "$ONLY" ] && [ "$p" != "$ONLY" ] && continue
          run_pair "$p" dry
      done
      ;;
  status)
      printf 'master switch : %s\n' "$(ini General enabled)"
      printf 'debounce      : %ss\n' "$(ini General debounce)"
      printf 'full sweep    : every %s min\n' "$(ini General periodicMinutes)"
      printf 'conflicts     : %s\n' "$(ini General conflictPolicy)"
      printf 'NAS mounted   : %s\n' "$(nas_ready && echo yes || echo NO)"
      echo
      for p in $(pairs); do
          d=$(ini "$p" deletions); d=${d:-keep}
          printf '%-12s %-30s <-> %-30s %-7s %-7s %s\n' "${p#Pair_}" "$(ini "$p" local)" "$(ini "$p" remote)" \
                 "$(ini "$p" direction)" "$d" "$([ "$(ini "$p" enabled)" = true ] && echo on || echo off)"
      done
      echo; echo "last log lines:"; tail -8 "$LOG" 2>/dev/null | sed 's/^/  /'
      ;;
  *) echo "usage: filesync [sync [--force] [Pair_X] | dry [Pair_X] | status]"; exit 2 ;;
esac
